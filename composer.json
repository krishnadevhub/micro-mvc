{
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "twig/twig": "^3.0",
        "symfony/routing": "^8.0",
        "symfony/http-foundation": "^8.0",
        "robmorgan/phinx": "^0.16.11",
        "symfony/dotenv": "^8.0",
        "filp/whoops": "^2.14",
        "symfony/yaml": "^8.0",
        "monolog/monolog": "^2.7",
        "symfony/dependency-injection": "^8.0",
        "kdevhubin/pdoentitygenerator": "^1.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "symfony/var-dumper": "^8.0",
        "phpstan/phpstan": "^1.7"
    },
    "config": {
        "allow-plugins": {
            "kdevhubin/pdoentitygenerator": true
        }
    }
}
